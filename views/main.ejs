<main>
    <h1 id="b"><%= p.b %>-board</h1>
    <ul>
        <% p.posts.map(e => { %>
            <li>
                <a href="/post/<%= e.id %>"><%= e.subject %></a>
                <p><i><%= (new Date(e.created_at)) %></i></p>
            </li>
        <% }); %>
    </ul>
    <div class="n"><a href="/<%= p.b %>/<%= p.n - 1 %>">back</a><a href="/<%= p.b %>/<%= p.n + 1 %>">next</a><div>
</main>